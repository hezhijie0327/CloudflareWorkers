{
    "name": "container",
    // Adjust to the worker name actually deployed on your account.
    "main": "worker.js",
    // Bump forward when upgrading wrangler; these Workers use only stable
    // runtime APIs (HTMLRewriter is proxy-only).
    // Cloudflare Builds deploys with the latest wrangler; keep this at its
    // release date. Same runtime cache switch as the blog site Worker.
    "compatibility_date": "2026-11-02",
    "cache": {
        "enabled": true
    },
    // Smart Placement: registry blob CDNs already live on Cloudflare's edge, so
    // the analysis may keep standard placement; auth/manifest requests benefit.
    "placement": {
        "mode": "smart"
    },
    "observability": {
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "invocation_logs": true,
            "persist": true
        },
        "traces": {
            "enabled": true,
            "head_sampling_rate": 1,
            "persist": true
        },
        "issue_detection": {
            "enabled": true
        }
    }
}
