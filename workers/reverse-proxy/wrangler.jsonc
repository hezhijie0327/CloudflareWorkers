{
    "name": "proxy",
    // Adjust to the worker name actually deployed on your account.
    "main": "worker.js",
    // Bump forward when upgrading wrangler; worker.js additionally uses
    // HTMLRewriter, WebSocketPair and Headers.getSetCookie.
    "compatibility_date": "2026-11-03",
    "observability": {
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "invocation_logs": true,
            "persist": true
        },
        "traces": {
            "enabled": true,
            "head_sampling_rate": 1,
            "persist": true
        },
        "issue_detection": {
            "enabled": true
        }
    }
}
