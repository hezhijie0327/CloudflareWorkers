{
    "name": "proxy",
    // Adjust to the worker name actually deployed on your account.
    "main": "worker.js",
    // Bump forward when upgrading wrangler; worker.js additionally uses
    // HTMLRewriter, WebSocketPair and Headers.getSetCookie.
    // Cloudflare Builds deploys with the latest wrangler; keep this at its
    // release date. Same runtime cache switch as the blog site Worker; the
    // worker sets no-store for rewritten pages, upstream headers govern the rest.
    "compatibility_date": "2026-11-02",
    "cache": {
        "enabled": true
    },
    "observability": {
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "invocation_logs": true,
            "persist": true
        },
        "traces": {
            "enabled": true,
            "head_sampling_rate": 1,
            "persist": true
        },
        "issue_detection": {
            "enabled": true
        }
    }
}
